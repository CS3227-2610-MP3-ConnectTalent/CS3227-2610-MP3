# Copy to .env.local and replace values with your local Supabase project details.
# `corepack pnpm exec supabase status` prints the local API URL and publishable key.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key
# Optional local-only HR seed. Copy the service-role key from local `supabase status`.
# Keep real values only in ignored .env.local; never use a hosted project key here.
# TEST_SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key
# LOCAL_HR_SEED_PASSWORD=choose-a-local-password
# Optional for a local or non-Vercel deployment. Defaults to http://localhost:3000.
# Vercel deployments use VERCEL_URL/VERCEL_PROJECT_PRODUCTION_URL automatically.
# APP_SITE_URL=http://localhost:3000

# Server-side SoCLaaS only. The gateway publishes an OpenAI-compatible /v1 API.
# Never expose these through NEXT_PUBLIC_ variables.
SOCLAAS_BASE_URL=https://soclaas-api.comp.nus.edu.sg/v1
SOCLAAS_API_KEY=replace-with-your-soclaas-key
SOCLAAS_MODEL=replace-with-an-available-model-id
