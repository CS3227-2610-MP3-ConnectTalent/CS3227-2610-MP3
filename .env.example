# Copy this file to .env.local and replace local placeholders as needed.
# Keep real credentials in ignored local env files; never commit them.
# Optional outside Vercel; local/non-Vercel development defaults to http://localhost:3000.
# Vercel provides VERCEL, VERCEL_ENV, VERCEL_URL, and
# VERCEL_PROJECT_PRODUCTION_URL automatically.
# APP_SITE_URL=http://localhost:3000

# Supabase application connection. The publishable key is public; access is enforced by RLS/grants.
# Run `corepack pnpm exec supabase status` for the local URL and publishable key.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key

# SoCLaaS is opt-in. Set true only after replacing the API key/model placeholders and
# setting one server-only Supabase key below for the AI quota/audit metadata RPCs.
SOCLAAS_AI_ENABLED=false
SOCLAAS_BASE_URL=https://soclaas-api.comp.nus.edu.sg/v1
SOCLAAS_API_KEY=replace-with-your-soclaas-key
SOCLAAS_MODEL=replace-with-an-available-model-id

# Server-only; required for AI and private résumé upload/cleanup. Use the modern secret key (preferred),
# or uncomment the legacy service-role key instead. Trusted helpers use it for AI metadata
# RPCs and authorized résumé staging/cleanup. Private content reads use the user's RLS session.
# SUPABASE_SECRET_KEY=replace-with-your-supabase-secret-key
# SUPABASE_SERVICE_ROLE_KEY=replace-with-your-legacy-service-role-key

# Optional local-only HR seed and privileged browser tests. Use the local Supabase
# Secret Key (or legacy service_role key) from `corepack pnpm exec supabase status`.
# This TEST_ variable is deliberately separate from the app runtime key; use only with
# the local project on port 54321, never with a hosted project.
# TEST_SUPABASE_SERVICE_ROLE_KEY=replace-with-local-supabase-secret-key
# LOCAL_HR_SEED_PASSWORD=choose-a-local-password

# Optional Supabase local integrations, not required by the careers app. Set these
# in the environment used by the Supabase CLI only when enabling the matching
# integration in supabase/config.toml. The app's Applicant/HR AI uses SoCLaaS above.
# OPENAI_API_KEY=replace-with-studio-only-openai-key
# SUPABASE_AUTH_SMS_TWILIO_AUTH_TOKEN=replace-with-twilio-auth-token
# SUPABASE_AUTH_EXTERNAL_APPLE_SECRET=replace-with-apple-oauth-secret
# S3_HOST=replace-with-s3-host
# S3_REGION=replace-with-s3-region
# S3_ACCESS_KEY=replace-with-s3-access-key
# S3_SECRET_KEY=replace-with-s3-secret-key
