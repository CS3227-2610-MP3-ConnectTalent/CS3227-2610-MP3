{
  "name": "company-careers-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:unit:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:critical": "playwright test tests/e2e/job-listings.spec.ts tests/e2e/applicant-applications.spec.ts tests/e2e/application-withdrawal.spec.ts tests/e2e/hr-application-review.spec.ts tests/e2e/ai-route-security.spec.ts",
    "test:db": "supabase test db",
    "test:race": "node tests/integration/application-races.mjs",
    "test:ai-race": "node tests/integration/ai-quota-races.mjs",
    "test:integration": "node tests/integration/application-races.mjs && node tests/integration/ai-quota-races.mjs && node tests/integration/application-withdrawal-races.mjs && node tests/integration/profile-resume-races.mjs && node tests/integration/resume-first-profile-races.mjs",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "seed:local-hr": "node --env-file=.env.local scripts/seed-local-hr.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "libphonenumber-js": "^1.13.15",
    "lucide-react": "^1.49.0",
    "next": "16.3.8",
    "openai": "^7.25.0",
    "pdf-lib": "^1.17.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.21.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.19.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "supabase": "^2.119.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@12.8.1"
}
